# Copy this file to .env or let install.sh create it.
# Never put the 24-word mnemonic in this file.
MINING_CONTROL_PASSWORD_HASH=""
MINING_CONTROL_BIND="0.0.0.0"
MINING_CONTROL_PORT="10200"
MINING_CONTROL_TLS="1"
MINING_CONTROL_REQUIRE_HTTPS="1"
MINING_CONTROL_NODE_NAME="quantus-miner"
MINING_CONTROL_CPU_WORKERS="8"
MINING_CONTROL_GPU_DEVICES="1"
MINING_CONTROL_CUDA_GPU="1"
MINING_CONTROL_GPU_BATCH_SIZE="16777216"
MINING_CONTROL_GPU_THROTTLE_MS="0"
MINING_CONTROL_HEARTBEAT_SECONDS="300"
MINING_CONTROL_HEARTBEAT_GRACE_SECONDS="180"
MINING_CONTROL_MINING_DIR="/root/quantus-mining"
MINING_CONTROL_NODE_BASE_PATH="/root/.local/share/quantus-node"
MINING_CONTROL_NODE_METRICS_PORT="9615"
MINING_CONTROL_NODE_RPC_PORT="9944"
MINING_CONTROL_MINER_LISTEN_PORT="9833"
MINING_CONTROL_MINER_METRICS_PORT="9900"
MINING_CONTROL_CHAIN="mainnet"
# Optional public URL override. On Vast.ai, install.sh detects PUBLIC_IPADDR
# and VAST_TCP_PORT_<MINING_CONTROL_PORT> automatically.
MINING_CONTROL_PUBLIC_HOST=""
MINING_CONTROL_PUBLIC_PORT=""
MINING_CONTROL_PUBLIC_URL=""
